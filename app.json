{
  "expo": {
    "name": "Code Swipe",
    "slug": "code-swipe",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E1022",
    "splash": {
      "backgroundColor": "#0E1022"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E1022"
      },
      "edgeToEdgeEnabled": true,
      "package": "net.learntime.codeswipe"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "65af3834-0b62-4afc-992f-c66d22761c6e"
      }
    }
  }
}
